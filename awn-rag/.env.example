# Supabase Session pooler connection string used by the RAG service.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Google AI Studio API key. Keep the real value in awn-rag/.env only.
GEMINI_API_KEY=replace-with-your-key

# Keep the model IDs already verified for your API key.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional; only set after verifying support for your selected model (for example: low).
# GEMINI_THINKING_LEVEL=low

# Optional retrieval settings.
MAX_DISTANCE=0.6
TOP_K=8
